{
  "name": "@elura/protocol",
  "version": "{{ELURA_VERSION}}",
  "description": "Standalone TypeScript client implementation of the Elura ELR2 protocol",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://elura.rustyspottedcat.dev/",
  "keywords": [
    "elura",
    "game-server",
    "protocol",
    "websocket"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/src",
    "proto",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node dist/test/golden.js"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
